{
  "info": {
    "name": "Jiwa Customer Portal - Integration Authentication",
    "description": "Checks the integration authentication entry page and completion endpoint. Postman cannot run the interactive Blazor login: use a JavaScript-enabled browser for the full login and debtor selection flow. The optional valid-token request requires a protected token captured before the browser submits it. Treat tokens and returned session IDs as secrets.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "portalBaseUrl",
      "value": "https://localhost:5001",
      "type": "string",
      "description": "Portal origin, without a trailing slash. Change to the actual portal URL."
    },
    {
      "key": "completionToken",
      "value": "",
      "type": "string",
      "description": "Optional short-lived protected token captured before the browser submits its completion form. Never commit or share this value."
    }
  ],
  "item": [
    {
      "name": "Sign-in page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{portalBaseUrl}}/integration/auth",
        "description": "Checks that the entry page is available. Postman only retrieves the HTML shell; open this URL in a browser to sign in and select a debtor."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Entry page responds with HTML', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
              "});",
              "pm.test('Entry page is not cacheable', function () {",
              "    pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing completion token",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [{ "key": "token", "value": "", "type": "text" }]
        },
        "url": "{{portalBaseUrl}}/integration/auth/result",
        "description": "Submits an empty completion token and expects a JSON failure."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Missing token returns a JSON failure', function () {",
              "    pm.response.to.have.status(400);",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(false);",
              "    pm.expect(body.errorMessage).to.eql('Missing authentication result.');",
              "    pm.expect(body.sessionId).to.eql(null);",
              "    pm.expect(body.debtor).to.eql(null);",
              "});",
              "pm.test('Result is not cacheable', function () {",
              "    pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid completion token",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [{ "key": "token", "value": "not-a-valid-token", "type": "text" }]
        },
        "url": "{{portalBaseUrl}}/integration/auth/result",
        "description": "Submits a malformed token and expects a JSON failure."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid token returns a JSON failure', function () {",
              "    pm.response.to.have.status(400);",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(false);",
              "    pm.expect(body.errorMessage).to.eql('Invalid or expired authentication result.');",
              "    pm.expect(body.sessionId).to.eql(null);",
              "    pm.expect(body.debtor).to.eql(null);",
              "});",
              "pm.test('Result is not cacheable', function () {",
              "    pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Optional - captured completion token",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [{ "key": "token", "value": "{{completionToken}}", "type": "text" }]
        },
        "url": "{{portalBaseUrl}}/integration/auth/result",
        "description": "Run manually only after capturing the token before the browser submits its completion POST. Set completionToken locally and send it to the same portal within two minutes. This request is not a login endpoint. The token can encode success or failure; either is a valid HTTP 200 result. Do not replay tokens or share the response."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Completion token was supplied', function () {",
              "    pm.expect(pm.variables.get('completionToken')).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('Completion returns the authentication result', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.be.a('boolean');",
              "    if (body.success) {",
              "        pm.expect(body.errorMessage).to.eql(null);",
              "        pm.expect(body.sessionId).to.be.a('string').and.not.empty;",
              "        pm.expect(body.debtor).to.be.an('object');",
              "        pm.expect(body.debtor.id).to.be.a('string').and.not.empty;",
              "        pm.expect(body.debtor).to.have.property('name');",
              "        pm.expect(body.debtor).to.have.property('contactNameId');",
              "        if (body.debtor.contactNameId !== null) {",
              "            pm.expect(body.debtor.contactNameId).to.be.a('string').and.not.empty;",
              "        }",
              "    } else {",
              "        pm.expect(body.errorMessage).to.be.a('string').and.not.empty;",
              "        pm.expect(body.sessionId).to.eql(null);",
              "        pm.expect(body.debtor).to.eql(null);",
              "    }",
              "});",
              "pm.test('Result is not cacheable', function () {",
              "    pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
